@inject IConfiguration Configuration

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @if (Configuration["GoogleAnalytics:MeasurementId"] is string gaId)
    {
        <!-- Google Analytics -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=@gaId"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '@gaId');
        </script>
    }
    <HeadOutlet />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link href="_content/Blazor.Bootstrap/blazor.bootstrap.css" rel="stylesheet" />
    <link rel="stylesheet" href="_content/gkwebNew/css/app.css" />
    <link rel="icon" type="image/png" href="_content/gkwebNew/favicon.png" />
    <link href="gkwebNew.Server.styles.css" rel="stylesheet" />
</head>

<body>
    <Routes />

    @if (Configuration["Recaptcha:SiteKey"] is string recaptchaSiteKey && !string.IsNullOrWhiteSpace(recaptchaSiteKey) && !recaptchaSiteKey.Contains("REPLACE_IN_PRODUCTION"))
    {
        <script>
            function renderRecaptchaWidgets() {
                document.querySelectorAll('.g-recaptcha').forEach(function (el) {
                    if (el.childElementCount === 0) {
                        grecaptcha.render(el, { sitekey: el.dataset.sitekey });
                    }
                });
            }
            function recaptchaOnload() {
                renderRecaptchaWidgets();
                // Retry once after a short delay in case Static SSR content lands after onload fires
                setTimeout(renderRecaptchaWidgets, 300);
            }
            document.addEventListener('enhancedload', function () {
                if (typeof grecaptcha !== 'undefined') renderRecaptchaWidgets();
            });
        </script>
        <script src="https://www.google.com/recaptcha/api.js?onload=recaptchaOnload&render=explicit" async defer></script>
    }
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
    <script src="_content/Blazor.Bootstrap/blazor.bootstrap.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
