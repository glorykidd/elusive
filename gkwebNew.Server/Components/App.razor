@inject IConfiguration Configuration

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @if (Configuration["GoogleAnalytics:MeasurementId"] is string gaId)
    {
        <!-- Google Analytics -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=@gaId"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '@gaId');
        </script>
    }
    <HeadOutlet />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link href="_content/Blazor.Bootstrap/blazor.bootstrap.css" rel="stylesheet" />
    <link rel="stylesheet" href="_content/gkwebNew/css/app.css" />
    <link rel="icon" type="image/png" href="_content/gkwebNew/favicon.png" />
    <link href="gkwebNew.Server.styles.css" rel="stylesheet" />
</head>

<body>
    <Routes />

    @if (Configuration["Recaptcha:SiteKey"] is string recaptchaSiteKey && !string.IsNullOrWhiteSpace(recaptchaSiteKey) && !recaptchaSiteKey.Contains("REPLACE_IN_PRODUCTION"))
    {
        <script>
            function renderRecaptchaWidgets() {
                if (typeof grecaptcha === 'undefined') return;
                document.querySelectorAll('.g-recaptcha').forEach(function (el) {
                    if (el.childElementCount === 0) {
                        try { grecaptcha.render(el, { sitekey: el.dataset.sitekey }); } catch (e) { console.error('reCAPTCHA render failed:', e); }
                    }
                });
            }
            function startRecaptchaObserver() {
                if (window._recaptchaMutationObserver) return;
                window._recaptchaMutationObserver = new MutationObserver(function () {
                    renderRecaptchaWidgets();
                    var els = document.querySelectorAll('.g-recaptcha');
                    if (els.length === 0 || Array.from(els).every(function (el) { return el.childElementCount > 0; })) {
                        window._recaptchaMutationObserver.disconnect();
                        window._recaptchaMutationObserver = null;
                    }
                });
                window._recaptchaMutationObserver.observe(document.body, { childList: true, subtree: true });
            }
            function recaptchaOnload() {
                renderRecaptchaWidgets();
                startRecaptchaObserver();
            }
            if (!window._recaptchaEnhancedLoadBound) {
                window._recaptchaEnhancedLoadBound = true;
                document.addEventListener('enhancedload', function () {
                    renderRecaptchaWidgets();
                    startRecaptchaObserver();
                });
            }
        </script>
        <script src="https://www.google.com/recaptcha/api.js?onload=recaptchaOnload&render=explicit" async defer></script>
    }
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
    <script src="_content/Blazor.Bootstrap/blazor.bootstrap.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
